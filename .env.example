# Copy this file to .env and fill in real values. .env is git ignored.
# A real process environment variable always beats the value written here.

# EODHD All-In-One API token. The only market data provider in the PIPELINE:
# every number the morning publishes comes from here. See the Alpaca note below
# for the one scheduled step that does not.
EODHD_API_TOKEN=

# Alpaca market data credentials, used by ONE scheduled step and nothing else.
# night/true_volume.py runs inside the 22:15 nightly and measures what premarket
# volume actually was from Alpaca's full SIP tape, once the session is over,
# writing BESIDE the morning's numbers and never over them. See CRITERIA.md
# [Truth] for why that vendor and why only at night: the free plan serves sip
# for a session that is finished and refuses it with HTTP 403 for one that is
# running, which is measured in doc/ALPACA_PROBE.md.
#
# Leave both blank and the morning is unaffected: the truth pass records that it
# could not reach the vendor and every _true column stays null with the reason.
# The research probes under src/research/ read the same two variables.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Resend API key used to email the finished report. Leave blank to skip delivery.
RESEND_API_KEY=

# Destination address for the morning report. Comma separate for several.
EMAIL_TO=

# Sender for the morning report. Resend accepts onboarding@resend.dev without
# a verified domain, so that is the default when this is left blank.
EMAIL_FROM=

# Note: ANTHROPIC_API_KEY is deliberately absent and must stay absent.
# analyst.py runs the claude CLI as a subprocess and uses the logged in
# subscription. config.py refuses to read or set that variable.
