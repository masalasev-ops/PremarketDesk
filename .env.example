# Copy this file to .env and fill in real values. .env is git ignored.
# A real process environment variable always beats the value written here.

# EODHD All-In-One API token. The only market data provider in this project.
EODHD_API_TOKEN=

# Resend API key used to email the finished report. Leave blank to skip delivery.
RESEND_API_KEY=

# Destination address for the morning report. Comma separate for several.
EMAIL_TO=

# Sender for the morning report. Resend accepts onboarding@resend.dev without
# a verified domain, so that is the default when this is left blank.
EMAIL_FROM=

# Note: ANTHROPIC_API_KEY is deliberately absent and must stay absent.
# analyst.py runs the claude CLI as a subprocess and uses the logged in
# subscription. config.py refuses to read or set that variable.
